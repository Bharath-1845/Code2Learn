# Code2Learn Environment Configuration

# Database
# For PostgreSQL: postgresql+asyncpg://c2l_user:secretpassword@localhost:5432/code2learn
# For local SQLite fallback: sqlite+aiosqlite:///./code2learn.db
DATABASE_URL=sqlite+aiosqlite:///./code2learn.db

# JWT Security
SECRET_KEY=super-secret-code2learn-key-change-in-production-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI (Optional - platform works with smart built-in hints fallback if key is empty)
GEMINI_API_KEY=

# Code Sandbox API (Piston)
# Self-hosted: http://localhost:2000/api/v2
# Public cloud: https://emkc.org/api/v2/piston
PISTON_URL=https://emkc.org/api/v2/piston

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
